ANTHROPIC_API_KEY=sk-ant-your-key-here

# X (Twitter) API v2 Bearer Token — for trend discovery
# Get from: https://developer.twitter.com/en/portal/dashboard
# Free tier works (Basic plan needed for search:recent)
X_BEARER_TOKEN=AAAAAAAAAA...

# Content generation
# english  = clear English, Roman-Urdu CTA lines kept as brand signatures (default)
# hinglish = Roman Urdu mixed with English throughout
CONTENT_LANGUAGE=english
CONTENT_MODEL=claude-haiku-4-5
