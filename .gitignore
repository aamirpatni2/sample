# Secrets — never commit these. .env.example is the template that IS committed.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# Agent run logs — may contain workspace content
runs/
*.jsonl

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Build artefacts
build/
dist/
*.egg-info/
